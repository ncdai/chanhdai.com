# Public values are embedded into the browser bundle during the image build.
NEXT_PUBLIC_APP_URL=https://adrienlachambre.com
NEXT_PUBLIC_REGISTRY_NAMESPACE=
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=
NEXT_PUBLIC_DMCA_URL=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# Server-only values. Configure them as Openship secrets, never in Git.
GITHUB_API_TOKEN=
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de
OPENPANEL_PROJECT_ID=
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
ADS_TXT=

# These are used by build/maintenance scripts, not required by the web runtime
# unless those scripts are run in production.
R2_S3_API=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

